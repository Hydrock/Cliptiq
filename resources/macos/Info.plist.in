<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>Cliptiq</string>
<key>CFBundleIdentifier</key><string>io.github.hydrock.Cliptiq</string>
<key>CFBundleName</key><string>Cliptiq</string>
<key>CFBundleDisplayName</key><string>Cliptiq</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
<key>CFBundleVersion</key><string>@PROJECT_VERSION@</string>
<key>LSMinimumSystemVersion</key><string>13.0</string>
<key>LSUIElement</key><true/>
<key>NSHighResolutionCapable</key><true/>
<key>SUFeedURL</key><string>@CLIPTIQ_UPDATE_FEED@</string>
<key>SUPublicEDKey</key><string>@CLIPTIQ_UPDATE_PUBLIC_KEY@</string>
<key>SUEnableAutomaticChecks</key><false/>
<key>SUEnableSystemProfiling</key><false/>
<key>SUAllowsAutomaticUpdates</key><false/>
<key>SUAutomaticallyUpdate</key><false/>
<key>SUVerifyUpdateBeforeExtraction</key><true/>
</dict></plist>
