set(CLIPTIQ_OCR_PREFIX "${CMAKE_SOURCE_DIR}/.toolchains/ocr/install-${CMAKE_SYSTEM_NAME}" CACHE PATH "Pinned offline OCR build prefix")
if(NOT EXISTS "${CLIPTIQ_OCR_PREFIX}/closure.json")
 message(FATAL_ERROR "Run python packaging/ocr/build.py before configuring Tesseract")
endif()
file(READ "${CLIPTIQ_OCR_PREFIX}/closure.json" closure)
file(READ "${CMAKE_SOURCE_DIR}/packaging/ocr/pins.json" expected_pins)
foreach(name leptonica tesseract eng rus)
 string(JSON expected GET "${expected_pins}" ${name} sha256)
 string(JSON actual GET "${closure}" pins ${name} sha256)
 if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "OCR prefix pin mismatch")
 endif()
endforeach()
file(GLOB tess_library "${CLIPTIQ_OCR_PREFIX}/lib/*tesseract*.a" "${CLIPTIQ_OCR_PREFIX}/lib/*tesseract*.lib")
file(GLOB lept_library "${CLIPTIQ_OCR_PREFIX}/lib/*lept*.a" "${CLIPTIQ_OCR_PREFIX}/lib/*lept*.lib")
foreach(library ${tess_library} ${lept_library})
 file(RELATIVE_PATH relative "${CLIPTIQ_OCR_PREFIX}" "${library}")
 string(JSON expected GET "${closure}" files "${relative}" sha256)
 file(SHA256 "${library}" actual)
 if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "OCR library changed after manifest")
 endif()
endforeach()
if(NOT tess_library OR NOT lept_library)
 message(FATAL_ERROR "Pinned static OCR libraries missing")
endif()
add_library(cliptiq_ocr_native STATIC platform/OcrTesseract.cpp)
target_include_directories(cliptiq_ocr_native PRIVATE core/src "${CLIPTIQ_OCR_PREFIX}/include")
target_link_libraries(cliptiq_ocr_native PRIVATE ${tess_library} ${lept_library})
if(UNIX)
 target_link_libraries(cliptiq_ocr_native PRIVATE m)
endif()
install(FILES "${CLIPTIQ_OCR_PREFIX}/tessdata/eng.traineddata" "${CLIPTIQ_OCR_PREFIX}/tessdata/rus.traineddata" DESTINATION tessdata)
