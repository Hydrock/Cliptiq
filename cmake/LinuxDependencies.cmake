find_package(PkgConfig REQUIRED)
pkg_check_modules(CLIPTIQ_XCB REQUIRED IMPORTED_TARGET xcb xcb-xfixes)
pkg_check_modules(CLIPTIQ_WAYLAND REQUIRED IMPORTED_TARGET wayland-client)
find_program(WAYLAND_SCANNER wayland-scanner REQUIRED)
set(protocol_root "${CMAKE_SOURCE_DIR}/platform/linux/protocols")
file(READ "${protocol_root}/pins.json" protocol_pins)
set(protocol_generated "${CMAKE_CURRENT_BINARY_DIR}/protocols")
file(MAKE_DIRECTORY "${protocol_generated}")
set(protocol_sources)
foreach(name ext-data-control-v1 wlr-data-control-unstable-v1)
  string(JSON expected GET "${protocol_pins}" "${name}.xml" sha256)
  file(SHA256 "${protocol_root}/${name}.xml" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Protocol XML hash mismatch: ${name}")
  endif()
  foreach(mode client-header server-header private-code)
    if(mode STREQUAL "private-code")
      set(output "${protocol_generated}/${name}-protocol.c")
      list(APPEND protocol_sources "${output}")
    else()
      set(output "${protocol_generated}/${name}-${mode}.h")
    endif()
    add_custom_command(OUTPUT "${output}"
      COMMAND "${WAYLAND_SCANNER}" "${mode}" "${protocol_root}/${name}.xml" "${output}"
      DEPENDS "${protocol_root}/${name}.xml" VERBATIM)
    list(APPEND protocol_outputs "${output}")
  endforeach()
endforeach()
add_library(cliptiq_linux_protocols STATIC ${protocol_sources} ${protocol_outputs})
target_include_directories(cliptiq_linux_protocols PUBLIC "${protocol_generated}")
target_link_libraries(cliptiq_linux_protocols PUBLIC PkgConfig::CLIPTIQ_WAYLAND)
target_compile_options(cliptiq_linux_protocols PRIVATE -ffunction-sections -fdata-sections -fvisibility=hidden)
