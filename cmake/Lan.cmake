# Pure controller tests use fake transport/credentials and never open sockets.
if(BUILD_TESTING)
 add_executable(lan_service_test tests/integration/lan_service_test.cpp platform/lan/Service.cpp)
 target_include_directories(lan_service_test PRIVATE "${CMAKE_SOURCE_DIR}")
 target_link_libraries(lan_service_test PRIVATE cliptiq_core)
 add_test(NAME lan_service COMMAND lan_service_test)
endif()
if(CLIPTIQ_LAN_SYNC)
 include("${CMAKE_CURRENT_LIST_DIR}/LanTls.cmake")
 target_sources(cliptiq_lan_tls PRIVATE platform/lan/Resolver.cpp)
 if(WIN32)
  target_compile_definitions(cliptiq_lan_tls PRIVATE _WIN32_WINNT=0x0602 NOMINMAX)
 elseif(NOT APPLE)
  target_link_libraries(cliptiq_lan_tls PRIVATE PkgConfig::CLIPTIQ_GTK)
 endif()
 # macOS DNSService APIs are re-exported by libSystem; no separate -ldns_sd.
 add_library(cliptiq_lan_native STATIC platform/lan/Service.cpp platform/lan/Secrets.cpp)
 target_include_directories(cliptiq_lan_native PUBLIC "${CMAKE_SOURCE_DIR}/platform")
 target_link_libraries(cliptiq_lan_native PUBLIC cliptiq_core cliptiq_lan_tls)
 if(WIN32)
  target_sources(cliptiq_lan_native PRIVATE platform/windows/LanSettings.cpp platform/lan/ImagesWindows.cpp)
  target_link_libraries(cliptiq_lan_native PUBLIC cliptiq_windows advapi32 bcrypt)
  target_compile_definitions(cliptiq_lan_native PRIVATE UNICODE _UNICODE NOMINMAX)
  target_compile_options(cliptiq_lan_native PRIVATE /utf-8 /Gy /Gw)
 elseif(APPLE)
  target_sources(cliptiq_lan_native PRIVATE platform/macos/LanSettings.mm platform/lan/ImagesMac.mm platform/lan/SecretsMac.mm)
  target_compile_options(cliptiq_lan_native PRIVATE $<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>)
  target_link_libraries(cliptiq_lan_native PUBLIC "-framework AppKit" "-framework ImageIO" "-framework Security")
 else()
  target_sources(cliptiq_lan_native PRIVATE platform/linux/LanSettings.cpp platform/lan/ImagesLinux.cpp platform/lan/SecretsLinux.cpp)
  target_link_libraries(cliptiq_lan_native PUBLIC PkgConfig::CLIPTIQ_GTK)
 endif()
 foreach(host cliptiq_app cliptiq_menu_host)
  if(TARGET ${host})
   target_link_libraries(${host} PRIVATE cliptiq_lan_native)
   target_compile_definitions(${host} PRIVATE CLIPTIQ_WITH_LAN=1)
  endif()
 endforeach()
 if(BUILD_TESTING)
  add_executable(lan_end_to_end_test tests/integration/lan_end_to_end_test.cpp)
  target_include_directories(lan_end_to_end_test PRIVATE "${CMAKE_SOURCE_DIR}")
  target_link_libraries(lan_end_to_end_test PRIVATE cliptiq_lan_native)
  add_test(NAME lan_end_to_end COMMAND lan_end_to_end_test)
  add_executable(lan_transport_test tests/integration/lan_transport_test.cpp)
  target_link_libraries(lan_transport_test PRIVATE cliptiq_lan_tls)
  add_test(NAME lan_tls_transport COMMAND lan_transport_test)
  add_executable(lan_resolver_test tests/integration/lan_resolver_test.cpp)
  target_link_libraries(lan_resolver_test PRIVATE cliptiq_lan_tls)
  add_test(NAME lan_dns COMMAND lan_resolver_test)
  add_executable(lan_secrets_test tests/unit/lan_secrets_test.cpp)
  target_include_directories(lan_secrets_test PRIVATE "${CMAKE_SOURCE_DIR}")
  target_link_libraries(lan_secrets_test PRIVATE cliptiq_lan_native)
  add_test(NAME lan_secrets COMMAND lan_secrets_test)
  if(WIN32)
   add_executable(lan_settings_test tests/integration/lan_settings_test.cpp)
   target_include_directories(lan_settings_test PRIVATE "${CMAKE_SOURCE_DIR}")
   target_link_libraries(lan_settings_test PRIVATE cliptiq_lan_native)
   target_compile_options(lan_settings_test PRIVATE /utf-8)
   target_compile_definitions(lan_settings_test PRIVATE UNICODE _UNICODE NOMINMAX)
   add_test(NAME lan_settings_native COMMAND lan_settings_test)
  elseif(APPLE)
   add_executable(macos_lan_settings_test tests/integration/macos_lan_settings_test.mm)
   target_include_directories(macos_lan_settings_test PRIVATE "${CMAKE_SOURCE_DIR}")
   target_compile_options(macos_lan_settings_test PRIVATE -fobjc-arc)
   target_link_libraries(macos_lan_settings_test PRIVATE cliptiq_lan_native cliptiq_settings_native)
   add_test(NAME lan_settings_native COMMAND macos_lan_settings_test)
   add_test(NAME lan_settings_native_ru COMMAND macos_lan_settings_test --ru)
   set_tests_properties(lan_settings_native lan_settings_native_ru PROPERTIES TIMEOUT 30)
  endif()
 endif()
endif()
