file(READ "${CMAKE_SOURCE_DIR}/third_party/tinyxml2/pins.json" xml_pins)
foreach(source tinyxml2.cpp tinyxml2.h LICENSE.txt)
  string(JSON expected GET "${xml_pins}" files "${source}")
  file(SHA256 "${CMAKE_SOURCE_DIR}/third_party/tinyxml2/${source}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "TinyXML2 ${source} hash mismatch")
  endif()
endforeach()
add_library(cliptiq_xml_parser STATIC third_party/tinyxml2/tinyxml2.cpp)
target_include_directories(cliptiq_xml_parser PUBLIC third_party/tinyxml2)
if(MSVC)
  target_compile_options(cliptiq_xml_parser PRIVATE /Gy /Gw)
else()
  target_compile_options(cliptiq_xml_parser PRIVATE -ffunction-sections -fdata-sections)
endif()
if(CLIPTIQ_SANITIZE AND NOT MSVC)
  target_compile_options(cliptiq_xml_parser PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
  target_link_options(cliptiq_xml_parser PUBLIC -fsanitize=address,undefined)
endif()
