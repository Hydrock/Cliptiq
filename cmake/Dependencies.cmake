# Same pinned, hash-verified SQLite as T01. No network access during configure.
set(CLIPTIQ_SQLITE_DIR "${CMAKE_SOURCE_DIR}/.toolchains/sqlite" CACHE PATH "Verified SQLite amalgamation")
if(NOT EXISTS "${CLIPTIQ_SQLITE_DIR}/sqlite3.c")
  message(FATAL_ERROR "Run python tools/fetch-footprint-deps.py before configuring")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" pins)
foreach(source sqlite3.c sqlite3.h)
  string(JSON expected GET "${pins}" files "${source}")
  file(SHA256 "${CLIPTIQ_SQLITE_DIR}/${source}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "SQLite ${source} hash mismatch; run the pinned fetcher")
  endif()
endforeach()
add_library(cliptiq_sqlite STATIC "${CLIPTIQ_SQLITE_DIR}/sqlite3.c")
target_include_directories(cliptiq_sqlite PUBLIC "${CLIPTIQ_SQLITE_DIR}")
target_compile_definitions(cliptiq_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_OMIT_LOAD_EXTENSION SQLITE_DQS=0 SQLITE_DEFAULT_MEMSTATUS=0)
if(UNIX)
  find_package(Threads REQUIRED)
  target_link_libraries(cliptiq_sqlite PRIVATE Threads::Threads ${CMAKE_DL_LIBS} m)
endif()
