set(grapheme_dir "${CMAKE_SOURCE_DIR}/third_party/libgrapheme")
file(READ "${grapheme_dir}/pins.json" grapheme_pins)
string(JSON count LENGTH "${grapheme_pins}" files)
math(EXPR last "${count}-1")
foreach(i RANGE ${last})
  string(JSON name MEMBER "${grapheme_pins}" files ${i})
  string(JSON expected GET "${grapheme_pins}" files "${name}")
  file(SHA256 "${grapheme_dir}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "libgrapheme ${name} hash mismatch")
  endif()
endforeach()
add_library(cliptiq_grapheme STATIC "${grapheme_dir}/src/character.c" "${grapheme_dir}/src/util.c" "${grapheme_dir}/src/utf8.c")
set_target_properties(cliptiq_grapheme PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
target_include_directories(cliptiq_grapheme PUBLIC "${grapheme_dir}")
if(MSVC)
  target_compile_options(cliptiq_grapheme PRIVATE /Gy /Gw)
  target_link_options(cliptiq_grapheme INTERFACE /OPT:REF)
elseif(APPLE)
  target_compile_options(cliptiq_grapheme PRIVATE -ffunction-sections -fdata-sections)
  target_link_options(cliptiq_grapheme INTERFACE -Wl,-dead_strip)
else()
  target_link_options(cliptiq_grapheme INTERFACE -Wl,--gc-sections)
  target_compile_options(cliptiq_grapheme PRIVATE -ffunction-sections -fdata-sections)
endif()
