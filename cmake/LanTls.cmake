include_directories("${CMAKE_CURRENT_LIST_DIR}")
set(MBEDTLS_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/lan-mbedtls-config.h" CACHE FILEPATH "" FORCE)
set(MBEDTLS_USER_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/lan-mbedtls-user-config.h" CACHE FILEPATH "" FORCE)
set(CLIPTIQ_MBEDTLS_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.toolchains/mbedtls-3.6.7")
if(NOT EXISTS "${CLIPTIQ_MBEDTLS_ROOT}/CMakeLists.txt")
 message(FATAL_ERROR "Missing pinned Mbed TLS. Run python tools/fetch-lan-deps.py before configuring (configure never downloads).")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/fetch-lan-deps.py" --verify-only RESULT_VARIABLE tls_verified OUTPUT_VARIABLE tls_verification ERROR_VARIABLE tls_error)
if(NOT tls_verified EQUAL 0)
 message(FATAL_ERROR "Pinned TLS verification failed: ${tls_verification}${tls_error}")
endif()
set(ENABLE_TESTING OFF CACHE BOOL "" FORCE)
set(ENABLE_PROGRAMS OFF CACHE BOOL "" FORCE)
set(USE_SHARED_MBEDTLS_LIBRARY OFF CACHE BOOL "" FORCE)
set(CMAKE_POLICY_DEFAULT_CMP0069 NEW)
add_subdirectory("${CLIPTIQ_MBEDTLS_ROOT}" "${CMAKE_BINARY_DIR}/mbedtls" EXCLUDE_FROM_ALL)
add_library(cliptiq_lan_tls STATIC "${CMAKE_CURRENT_LIST_DIR}/../platform/lan/Transport.cpp")
target_sources(cliptiq_lan_tls PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../platform/lan/CryptoRuntime.cpp" "${CMAKE_CURRENT_LIST_DIR}/../platform/lan/PairingCrypto.cpp")
target_include_directories(cliptiq_lan_tls PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../core/include" "${CMAKE_CURRENT_LIST_DIR}/../platform")
target_compile_features(cliptiq_lan_tls PUBLIC cxx_std_17)
target_link_libraries(cliptiq_lan_tls PUBLIC mbedtls mbedcrypto mbedx509)
if(WIN32)
 target_link_libraries(cliptiq_lan_tls PRIVATE ws2_32)
else()
 find_package(Threads REQUIRED)
 target_link_libraries(cliptiq_lan_tls PRIVATE Threads::Threads)
endif()
